# Variables de entorno del backend (@dpages/backend).
# Copiá este archivo a .env en la raíz del monorepo y completá los valores.
# Nunca commitear el .env real (ya está en .gitignore).

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP. En Cloud Run SIEMPRE lo inyecta la plataforma vía process.env.PORT;
# en local se usa este valor.
PORT=8080

# Nivel de log de Pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Cadena de conexión a PostgreSQL. Es la ÚNICA variable que cambia al migrar
# de local a Cloud SQL — todo lo demás queda igual (ver ADR en
# docs/decisiones-arquitectura.md).
#
# Local (docker compose up — servicio "postgres", puerto 5433 del host):
DATABASE_URL=postgres://dpages:dpages@localhost:5433/dpages
#
# Local, contra la base de tests (servicio "postgres-test", puerto 5434):
# DATABASE_URL=postgres://dpages:dpages@localhost:5434/dpages_test
#
# Cloud SQL (vía Cloud SQL Auth Proxy / conector nativo de Cloud Run, socket
# unix — nótese que no hay host entre "@" y "/"):
# DATABASE_URL=postgresql://usuario:password@/dpages?host=/cloudsql/PROYECTO:REGION:INSTANCIA

# Máximo de conexiones del pool. Cloud Run escala instancias (cada una abre
# su propio pool) y Cloud SQL en instancias chicas tiene pocas conexiones
# disponibles — mantenerlo bajo. Default: 5.
DB_POOL_MAX=5

# API REST v3 de WooCommerce (ADR-001: /wp-json/wc/v3/, nunca la legacy).
# Generada en WooCommerce → Ajustes → Avanzado → REST API. La credencial
# tiene que ser de SÓLO LECTURA — el sistema nunca escribe de vuelta.
WC_BASE_URL=https://dpages.cat
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ────────────────────────────────────────────────────────────
# Las variables del endpoint de tareas se agregan en una próxima capa y se
# documentan acá a medida que existen, para que este archivo esté siempre
# sincronizado con lo que packages/backend/src/config/env.ts valida.
# ────────────────────────────────────────────────────────────
