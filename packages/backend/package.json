{
  "name": "@dpages/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de dPagès: servidor HTTP, integración de sólo lectura con WooCommerce, acceso a datos.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts up",
    "migrate:status": "tsx --env-file-if-exists=../../.env src/db/migrate.ts status",
    "ingerir": "tsx --env-file-if-exists=../../.env src/scripts/ingerir.ts",
    "transformar": "tsx --env-file-if-exists=../../.env src/scripts/transformar.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@dpages/shared": "*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.1.0",
    "firebase-admin": "^14.2.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
