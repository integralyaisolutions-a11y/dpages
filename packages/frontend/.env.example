# Copiá este archivo a .env.local (npm/Next.js lo carga automáticamente,
# nunca hace falta reiniciar nada manualmente aparte del propio dev server)
# y completá los valores reales. Ver SETUP.md / README.md de este paquete
# para qué es cada variable y de dónde sacarla.
#
# Ninguna de estas variables es secreta en el sentido estricto (todas viajan
# al navegador, prefijo NEXT_PUBLIC_ obligatorio en Next.js para que sean
# visibles del lado del cliente) — pero igual no se commitean con valores
# reales, .env.local está en .gitignore.

# URL base del backend (Fastify). En desarrollo local, el backend corre en
# el puerto 8080 (ver packages/backend/.env, variable PORT).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Config del proyecto de Firebase (sólo Authentication — ver
# src/lib/firebase.ts). Pedile los valores reales a un compañero del equipo
# o sacalos de la consola de Firebase del proyecto (Configuración del
# proyecto → General → tus apps → SDK de Firebase).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
